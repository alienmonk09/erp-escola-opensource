# .env.example — modelo do .env local (NÃO versionar o .env; só o exemplo)
# Copie para `.env` (ignorado pelo .gitignore — RS-060) e TROQUE os valores:
#   cp .env.example .env
#
# Estes valores servem SOMENTE ao banco local de dev/testes do `task dev`.
# Produção/preview usam secrets do Neon via GitHub Secrets/Vercel.

# Usuário do banco local (obrigatório; sem padrão no repo — AGENTS.md §4.6).
POSTGRES_USER=sacre_dev
# Senha do banco local (obrigatório; troque por qualquer valor só-seu, só-local).
POSTGRES_PASSWORD=troque-esta-senha-somente-local
# Database local (opcional).
POSTGRES_DB=erp_escola
# Porta publicada em loopback (opcional).
POSTGRES_PORT=5432
# Porta do backend hello em loopback (opcional).
BACKEND_PORT=8080
# Porta do frontend Vite em loopback (opcional).
FRONTEND_PORT=5173
# String da aplicação (pooler/local). Nunca commitar o .env (RS-060).
# DATABASE_URL=postgres://sacre_dev:troque-esta-senha-somente-local@127.0.0.1:5432/erp_escola?sslmode=disable
